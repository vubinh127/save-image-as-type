{
  "manifest_version": 3,
  "name": "Save Image As Type",
  "version": "1.0.0",
  "description": "Right-click any image to save it as JPEG, PNG, WebP, or AVIF",
  "permissions": [
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16_v2.png",
    "48": "icons/icon48_v2.png",
    "128": "icons/icon128_v2.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16_v2.png",
      "48": "icons/icon48_v2.png",
      "128": "icons/icon128_v2.png"
    }
  }
}
